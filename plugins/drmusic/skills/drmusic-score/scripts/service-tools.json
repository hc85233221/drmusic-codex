  {
    "name": "drm_get_piano_score",
    "description": "Read one owned piano score with its original key when provided and all written notes. numberedUrl downloads printable numbered notation when opened by the owner. If needed append &key= with the URL-encoded user-confirmed key, e.g. Bb major. Each page has up to 256 notes. Follow next with the same id and revision until null. Append the first measure at noteOffset when continuing inside a dense measure.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "startMeasure": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024,
          "description": "First measure on this page, one-based."
        },
        "revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "description": "Use the revision from the first page to keep one consistent score."
        },
        "measureCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "default": 8
        },
        "noteOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16000,
          "default": 0
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "drm_annotate_piano_study",
    "description": "Apply only the requested piano study suggestions to private beat notes on the owned score. Set preview:true to read without writing. Keep the same revision and kinds and follow next to finish. Report skipped tooLong and conflict cells; retry a conflict after rereading. The existing website displays the combined note.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kinds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "startMeasure": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024,
          "description": "First measure on this page, one-based."
        },
        "revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "description": "Use the revision from the first page to keep one consistent score."
        },
        "measureCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "default": 8
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "fingering",
              "leftChord"
            ]
          }
        },
        "preview": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "drm_set_guitar_video",
    "description": "Set or replace the music video on one owned guitar chart using its existing ID. Verify the artist and song first. To remove the link pass null. Changing the video affects its shared view.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        }
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false,
      "idempotentHint": true
    }
  },
  {
    "name": "drm_attach_original",
    "description": "Attach one private JPEG or PNG photo to an existing owned score. Replacing the attachment preserves the playable score. Use standard base64 without a data URL, up to 768 KiB decoded. For a larger photo use the website (up to 8 MiB).",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mimeType",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "mimeType": {
          "type": "string",
          "enum": [
            "image/jpeg",
            "image/png"
          ]
        },
        "data": {
          "type": "string",
          "maxLength": 1048576
        }
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "drm_list_scores",
    "description": "List the titles and IDs of the signed-in DrMusic account’s scores.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
  }
