[
  {
    "name": "drm_publish_score",
    "description": "Transcribe the supplied sheet photo into playable notes, then seal and upload the score to the signed-in DrMusic account. Use rests as gaps, simultaneous starts for chords, and both hands where written. Ask about unreadable notes before uploading. The returned URL opens the score.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score"
      ],
      "properties": {
        "score": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "bpm",
            "timeSignature",
            "measures"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            },
            "composer": {
              "type": "string",
              "maxLength": 180
            },
            "key": {
              "type": "string",
              "maxLength": 60
            },
            "bpm": {
              "type": "integer",
              "minimum": 30,
              "maximum": 240
            },
            "timeSignature": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer"
              },
              "description": "[numerator 1..32, denominator 1/2/4/8/16/32]"
            },
            "measures": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1024,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "notes"
                ],
                "properties": {
                  "notes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "midi",
                        "start",
                        "duration",
                        "hand"
                      ],
                      "properties": {
                        "midi": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 127
                        },
                        "start": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Quarter beats from start of measure."
                        },
                        "duration": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "description": "Quarter beats. A tie can span multiple measures."
                        },
                        "hand": {
                          "type": "string",
                          "enum": [
                            "right",
                            "left"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "description": "Reuse across retries for the same transcription; omit to deduplicate by score content."
        }
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false,
      "idempotentHint": true
    }
  },
  {
    "name": "drm_import_package",
    "description": "Import an existing .drm file into the signed-in account that issued it. Read its UTF-8 text and pass it as package. Retrying the same file returns the same score ID and URL.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package"
      ],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1,
          "maxLength": 921602,
          "description": "The DRM1 package text from the user-selected .drm file."
        }
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false,
      "idempotentHint": true
    }
  },
